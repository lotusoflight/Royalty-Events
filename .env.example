# ─────────────────────────────────────────────
# Royalty Events — Environment Configuration
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Django Core
SECRET_KEY=replace-me-with-a-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (leave blank to use SQLite for local dev)
DATABASE_URL=

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Royalty Events <noreply@royaltyevents.com>
STAFF_NOTIFICATION_EMAIL=staff@royaltyevents.com

# Static & Media (production)
STATIC_ROOT=/var/www/royalty/staticfiles
MEDIA_ROOT=/var/www/royalty/media
